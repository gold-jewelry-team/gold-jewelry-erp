APP_NAME=黃金珠寶進銷存暨營運管理系統
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gold_jewelry_erp
APP_MAINTENANCE_MODE=false

# Production only: set real values in Render Environment, never commit secrets.
ADMIN_USERNAME=replace-with-admin-login-name
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_SECURE=true
